---
import {getCollection,render} from 'astro:content';import SiteLayout from '../../layouts/SiteLayout.astro';import Artwork from '../../components/Artwork.astro';import NewsCard from '../../components/NewsCard.astro';
export async function getStaticPaths(){return (await getCollection('news',({data})=>!data.draft)).map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);const related=(await getCollection('news',({data})=>!data.draft)).filter(item=>item.id!==entry.id).slice(0,2);
---
<SiteLayout title={entry.data.title} description={entry.data.description} article={entry.data}><article><header class="article-header container"><a class="text-link" href="/tin-tuc/">← Tin tức & góc sáng tạo</a><p class="eyebrow">{entry.data.category}</p><h1>{entry.data.title}</h1><p>{entry.data.description}</p><div class="article-meta"><span>Black Lantern Studio</span><time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('vi-VN',{day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Ho_Chi_Minh'})}</time></div></header><div class="container article-cover"><Artwork kind={entry.data.image} eager alt="Tranh ý tưởng của Black Lantern Studio" /></div><div class="prose"><Content /><aside class="article-note">Hình ảnh minh họa ý tưởng của studio, không phải ảnh gameplay.</aside></div></article><section class="section container"><div class="section-heading"><h2>Đọc tiếp câu chuyện</h2><span class="heading-rule"></span></div><div class="cards-grid two">{related.map(item=><NewsCard entry={item} />)}</div></section></SiteLayout>
