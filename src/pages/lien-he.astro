---
import SiteLayout from '../layouts/SiteLayout.astro';import Hero from '../components/Hero.astro';import Logo from '../components/Logo.astro';import {site} from '../data/site';
---
<SiteLayout title="Liên hệ" description="Kết nối với Black Lantern Studio để trao đổi hợp tác, báo chí và góp ý. Gửi lời nhắn hoặc liên hệ qua email và Facebook chính thức."><Hero eyebrow="KẾT NỐI VỚI STUDIO" title="Một lời nhắn. Một khởi đầu." description="Chia sẻ ý tưởng, câu chuyện hoặc điều bạn muốn cùng chúng tôi khám phá." kind="lotus" /><section class="section container contact-layout"><aside class="contact-info"><Logo large /><div><span class="eyebrow">EMAIL</span><a href={'mailto:'+site.email}>{site.email}</a></div><div><span class="eyebrow">FACEBOOK</span><a href={site.facebook} target="_blank" rel="noopener noreferrer">Black Lantern Studio ↗</a></div><div><span class="eyebrow">STUDIO ĐỘC LẬP</span><span>Việt Nam</span></div></aside><div class="form-panel"><h2>Gửi lời nhắn cho chúng tôi</h2><p>Mọi cuộc trò chuyện đều bắt đầu bằng sự lắng nghe.</p><form id="contact-form" action="/api/contact" method="post"><div class="form-grid"><div><label for="name">Họ và tên *</label><input id="name" name="name" autocomplete="name" required minlength="2" maxlength="100" /></div><div><label for="email">Email *</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" /></div></div><label for="topic">Nội dung liên hệ *</label><select id="topic" name="topic" required><option value="">Chọn chủ đề</option><option value="partnership">Hợp tác phát triển</option><option value="press">Báo chí & sáng tạo nội dung</option><option value="feedback">Góp ý từ người chơi</option><option value="other">Trao đổi khác</option></select><label for="message">Lời nhắn *</label><textarea id="message" name="message" rows="6" required minlength="20" maxlength="5000" placeholder="Bạn muốn chia sẻ điều gì với studio?"></textarea><div class="honey" aria-hidden="true"><label for="website">Không điền trường này</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div><p class="form-note">Không gửi mật khẩu, thông tin thanh toán hoặc dữ liệu nhạy cảm. Lời nhắn được lưu riêng để studio tiếp nhận và phản hồi qua email bạn cung cấp. <a href="/chinh-sach-rieng-tu/">Chính sách riêng tư</a>.</p><button class="button submit-button" type="submit">Gửi lời nhắn →</button><div id="form-status" role="status" aria-live="polite" tabindex="-1"></div></form></div></section>
<script>
const form=document.querySelector<HTMLFormElement>('#contact-form');const status=document.getElementById('form-status');const submit=form?.querySelector<HTMLButtonElement>('button[type=submit]');form?.addEventListener('submit',async(event)=>{event.preventDefault();if(!form.reportValidity()||!submit||!status)return;submit.disabled=true;submit.textContent='Đang gửi…';status.textContent='';try{const body=new URLSearchParams();new FormData(form).forEach((value,key)=>body.set(key,String(value)));const response=await fetch('/api/contact',{method:'POST',body,headers:{Accept:'application/json'}});const data=await response.json();if(!response.ok)throw new Error(data.message||'Chưa thể gửi lời nhắn. Vui lòng thử lại.');status.textContent='Lời nhắn đã được tiếp nhận. Mã tham chiếu: '+data.reference+'. Bạn có thể liên hệ email studio nếu cần trao đổi thêm.';status.className='success';form.reset();}catch(error){status.textContent=error instanceof Error?error.message:'Có lỗi kết nối. Vui lòng thử lại hoặc gửi email trực tiếp.';status.className='error';}finally{submit.disabled=false;submit.textContent='Gửi lời nhắn →';status.focus();}});
</script></SiteLayout>
