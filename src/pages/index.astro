---
import {getCollection} from 'astro:content';import SiteLayout from '../layouts/SiteLayout.astro';import Hero from '../components/Hero.astro';import Artwork from '../components/Artwork.astro';import SectionHeading from '../components/SectionHeading.astro';import NewsCard from '../components/NewsCard.astro';import Community from '../components/Community.astro';
const news=(await getCollection('news',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<SiteLayout title="Trang chủ"><Hero home title="Thắp sáng những câu chuyện Việt." description="Studio game độc lập từ Việt Nam. Chúng tôi kể chuyện bằng trò chơi."><a class="button" href="/tro-choi/">Khám phá trò chơi →</a><a class="button button-outline" href="/ve-studio/">Về chúng tôi</a></Hero>
<div class="quicklinks container"><a href="/tro-choi/"><span class="quick-icon" aria-hidden="true">◇</span><span>Trò chơi của chúng tôi<small>Những hành trình đang thành hình</small></span><b aria-hidden="true">↗</b></a><a href="/tin-tuc/"><span class="quick-icon" aria-hidden="true">▤</span><span>Góc sáng tạo<small>Câu chuyện phía sau ngọn đèn</small></span><b aria-hidden="true">↗</b></a><a href="/lien-he/"><span class="quick-icon" aria-hidden="true">✧</span><span>Kết nối cùng studio<small>Một ý tưởng, nhiều khả năng</small></span><b aria-hidden="true">↗</b></a></div>
<section class="section container"><SectionHeading title="Những thế giới đang ấp ủ" /><a class="game-feature" href="/tro-choi/du-an-dau-tien/"><Artwork kind="lotus" class="feature-art" /><div class="feature-content"><span class="badge">Từ những ý tưởng đầu tiên</span><h2>Một hành trình<br />đang được thắp sáng.</h2><p>Cảm hứng Việt. Tinh thần khám phá. Những câu chuyện chờ được kể.</p><span class="button">Tìm hiểu định hướng →</span></div><span class="art-caption">Tranh ý tưởng của studio</span></a></section>
<section class="section container"><SectionHeading title="Tin tức & góc sáng tạo" href="/tin-tuc/" /><div class="cards-grid">{news.slice(0,3).map(entry=><NewsCard entry={entry} />)}</div></section>
<section class="section container studio-split"><div class="studio-visual"><Artwork alt="Dòng sông và làng quê trong tranh ý tưởng của Black Lantern Studio" /><span class="floating-label">TỪ VIỆT NAM<br />VỚI TRÍ TƯỞNG TƯỢNG</span></div><div><p class="eyebrow">VỀ BLACK LANTERN</p><h2>Người Việt.<br />Câu chuyện Việt.</h2><p>Chúng tôi tin rằng trò chơi có thể mở ra những cuộc phiêu lưu và lưu giữ những cảm xúc rất riêng.</p><p>Black Lantern Studio là studio game độc lập tại Việt Nam, theo đuổi những trải nghiệm giàu cảm xúc và cốt truyện.</p><a class="button button-outline" href="/ve-studio/">Câu chuyện của studio →</a></div></section><Community /></SiteLayout>
