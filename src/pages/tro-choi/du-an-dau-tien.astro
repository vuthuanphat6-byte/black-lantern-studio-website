---
import SiteLayout from '../../layouts/SiteLayout.astro';import Hero from '../../components/Hero.astro';import Artwork from '../../components/Artwork.astro';import Community from '../../components/Community.astro';
---
<SiteLayout title="Dự án đầu tiên — Định hướng sáng tạo" description="Một góc nhìn vào định hướng sáng tạo của Black Lantern Studio: cảm hứng Việt, những câu chuyện giàu cảm xúc và tinh thần khám phá."><Hero eyebrow="TRÒ CHƠI / DỰ ÁN ĐẦU TIÊN" title="Mỗi hành trình bắt đầu từ một ánh đèn." description="Những ý tưởng đầu tiên cho chương tiếp theo của Black Lantern Studio."><a class="button" href="#dinh-huong">Khám phá định hướng ↓</a></Hero><section id="dinh-huong" class="section container"><div class="intro-grid"><h2>Đi tìm câu chuyện<br />trong điều thân thuộc.</h2><div><p>Một mái nhà bên sông, khoảng sân dưới tán cây, ánh đèn trong đêm. Những chất liệu gần gũi là nơi trí tưởng tượng của chúng tôi bắt đầu.</p><p>Trang này giới thiệu định hướng sáng tạo. Dự án chưa công bố tên, cơ chế gameplay, nền tảng hay lịch phát hành.</p></div></div><div class="values-grid"><article><span>01 / BẢN SẮC</span><h3>Cảm hứng Việt</h3><p>Quan sát cảnh quan, đời sống và những câu chuyện xung quanh để tìm chất liệu sáng tạo.</p></article><article><span>02 / CẢM XÚC</span><h3>Câu chuyện ở lại</h3><p>Theo đuổi những trải nghiệm tạo kết nối với người chơi qua thế giới và nhân vật.</p></article><article><span>03 / KHÁM PHÁ</span><h3>Một lời mời bước tiếp</h3><p>Nuôi dưỡng sự tò mò, từ những chi tiết nhỏ đến những hành trình rộng mở.</p></article></div></section><section class="section container"><div class="section-heading"><h2>Hình ảnh ý tưởng</h2><span class="heading-rule"></span></div><div class="gallery-grid"><button class="gallery-open" data-image="/art/hero-vietnam.webp" data-caption="Cảnh quan Việt — tranh ý tưởng"><Artwork alt="Cảnh quan Việt trong ánh chiều, mở ảnh lớn" /></button><button class="gallery-open" data-image="/art/lotus-river.webp" data-caption="Ánh đèn trên sông — tranh ý tưởng"><Artwork kind="lotus" alt="Đèn sen trên sông, mở ảnh lớn" /></button></div><p class="muted">Tranh minh họa ý tưởng, không phải ảnh gameplay. Bấm vào ảnh để xem lớn.</p><dialog class="gallery-dialog"><button class="gallery-close button button-small" autofocus>Đóng ✕</button><img id="gallery-image" alt="" /><p id="gallery-caption"></p></dialog></section><Community />
<script>
const dialog=document.querySelector<HTMLDialogElement>('.gallery-dialog');const pic=document.querySelector<HTMLImageElement>('#gallery-image');const caption=document.getElementById('gallery-caption');let opener:HTMLElement|null=null;document.querySelectorAll<HTMLButtonElement>('.gallery-open').forEach(button=>button.addEventListener('click',()=>{opener=button;if(pic){pic.src=button.dataset.image!;pic.alt=button.dataset.caption!;}if(caption)caption.textContent=button.dataset.caption!;dialog?.showModal();}));document.querySelector('.gallery-close')?.addEventListener('click',()=>dialog?.close());dialog?.addEventListener('close',()=>opener?.focus());dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
</script></SiteLayout>
