[Unit]
Description=Black Lantern Studio website
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=blacklantern
Group=blacklantern
WorkingDirectory=/srv/black-lantern/current
ExecStart=/usr/local/bin/node /srv/black-lantern/current/server/index.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4280
Environment=SITE_ORIGIN=https://blacklantern.games
Environment=TRUST_CLOUDFLARE=1
Environment=CONTACT_DIR=/var/lib/black-lantern
Environment=STATIC_DIR=/srv/black-lantern/current/dist
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StateDirectory=black-lantern
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=256M
CPUQuota=50%
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
